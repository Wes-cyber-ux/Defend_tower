    %% Herencia
    Enemigo <|-- Goblin
    Enemigo <|-- Orco
    Enemigo <|-- Troll
    Defensa <|-- Arquero
    Defensa <|-- Mago
    Defensa <|-- Canon

    %% Composicion
    Juego "1" *-- "1" Mapa
    Juego "1" *-- "1" Torre
    Juego "1" *-- "1" Jugador
    Juego "1" *-- "1" Estadisticas
    Juego "1" *-- "0..*" Defensa : crea y destruye
    Oleada "1" *-- "1..*" Enemigo : crea y destruye
    Estadisticas "1" *-- "0..*" Partida

    %% Agregacion
    Mapa "1" o-- "0..*" Defensa : referencia

    %% Asociacion
    Defensa "0..*" --> "0..1" Enemigo : objetivo

    %% Dependencias (uso temporal)
    Juego ..> Oleada : crea una por oleada
    Oleada ..> Torre : la daña
    Oleada ..> Mapa : consulta
    Defensa ..> Mapa : consulta
    Mapa ..> Enemigo : dibuja
    Juego ..> Consola : usa
